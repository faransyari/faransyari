# Copy to .env and fill in. Everything here is optional:
# you can also sign in from the Account page once the site is running.

# Instagram account used to read follower lists. A session file is saved
# after the first successful login, so the password is only needed once.
IG_USERNAME=
IG_PASSWORD=

# Signs the browser session cookie. Generated and stored in instance/ if unset.
SECRET_KEY=

# Hard cap on how many followers one lookup may fetch (default 100).
MAX_FOLLOWERS=100

# Where the site listens. Keep 127.0.0.1 unless you know you want it on your network.
HOST=127.0.0.1
PORT=5000
